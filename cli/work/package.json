{
  "name": "@art-work/cli",
  "version": "0.1.2",
  "description": "CLI for discovering projects, inspecting and synchronizing checkouts, linking resources, and executing commands across them.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-work",
    "directory": "cli/work"
  },
  "type": "module",
  "bin": {
    "art-work-cli": "./dist/esm/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.mjs"
    },
    "./config": {
      "types": "./dist/esm/config/index.d.ts",
      "import": "./dist/esm/config/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "build:types:esm": "tsc --project tsconfig.esm.json",
    "build:types:cjs": "tsc --project tsconfig.cjs.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@art-lib/fs-records": "^0.0.1",
    "commander": "^12.0.0",
    "esbuild": "^0.28.0",
    "simple-git": "^3.24.0"
  },
  "devDependencies": {}
}
