{
  "name": "@art-works/workspace-cli",
  "version": "0.3.0",
  "description": "CLI for discovering projects, inspecting and synchronizing checkouts, linking resources, and executing commands across them.",
  "keywords": [
    "cli",
    "workspaces",
    "tooling",
    "art",
    "agent-workflows",
    "multi-repository",
    "git"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-works",
    "directory": "cli/workspace"
  },
  "type": "module",
  "bin": {
    "art-workspace-cli": "./dist/index.mjs"
  },
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --dir src --coverage",
    "test:integration": "vitest run --dir test",
    "ci": "npm run lint && npm run build && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@art-lib/fs-records": "0.0.2",
    "commander": "12.0.0",
    "esbuild": "0.28.0",
    "simple-git": "3.36.0"
  },
  "devDependencies": {}
}
